# Supabase - criado em https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nunca exponha esta chave no frontend; usada apenas em codigo server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publica do site (usada em redirects de autenticacao e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamento simulado (apenas desenvolvimento). Nunca defina como true em producao.
ENABLE_MOCK_PAYMENTS=true

# Stripe (server-side apenas; nunca exponha estas chaves no frontend).
# Use apenas chaves de TEST (sk_test_... / whsec_...) durante o desenvolvimento.
STRIPE_SECRET_KEY=sk_test_your-test-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret
