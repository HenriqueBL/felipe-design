# Supabase - criado em https://supabase.com/dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Nunca exponha esta chave no frontend; usada apenas em codigo server-side.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# URL publica do site (usada em redirects de autenticacao e SEO)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Pagamento simulado (apenas desenvolvimento). Nunca defina como true em producao.
ENABLE_MOCK_PAYMENTS=true

# Stripe NAO e mais configurado por .env: as credenciais (secret key e
# webhook signing secret) sao definidas pelo Admin em Settings > Stripe
# Payments e armazenadas cifradas no Supabase Vault. Sem configuracao, o
# app inicia normalmente e pagamentos falham de forma segura.

# Geo-based market resolution (locale + currency).
# DISABLED by default — without this var, all traffic falls back to en/USD.
# Enable ONLY after the full trust boundary is configured:
#   Cloudflare proxy → CF-IPCountry → nginx → X-Origin-Country → app
# The app trusts only the internal header written by nginx, never public
# headers like cf-ipcountry or x-vercel-ip-country that clients can forge.
# See docs/production-deploy.md §Production Geo Trust for activation order.
# TRUSTED_GEO_SOURCE=x-origin-country
